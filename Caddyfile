{
	admin off
	auto_https off
}

# Public HTTPS when the ISP actually forwards 443 → HTTPS_HOST_PORT.
{$PUBLIC_DOMAIN} {
	tls /certs/{$PUBLIC_DOMAIN}.crt /certs/{$PUBLIC_DOMAIN}.key

	encode zstd gzip

	@miniapp path /app /app/* /api/miniapp/* /uploads/*
	handle @miniapp {
		reverse_proxy admin:{$ADMIN_PORT:8080} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		respond 404
	}
}

# Plain HTTP on the Docker network only (not published on the host). Used by
# Cloudflare quick tunnel so the admin UI never leaves the LAN.
:80 {
	encode zstd gzip

	@miniapp path /app /app/* /api/miniapp/* /uploads/*
	handle @miniapp {
		reverse_proxy admin:{$ADMIN_PORT:8080} {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		respond 404
	}
}
