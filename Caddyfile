{
	admin off
	# Prefer DNS-01 via DuckDNS. HTTP challenge stays off so UGOS can keep host :80.
	# TLS-ALPN is left available as a fallback when the ISP actually forwards 443.
	auto_https disable_redirects
}

{$PUBLIC_DOMAIN} {
	tls {
		dns duckdns {
			api_token {env.DUCKDNS_TOKEN}
		}
	}

	encode zstd gzip

	# Only the Mini App surface is published. The admin UI keeps answering on the
	# LAN port (ADMIN_HOST_PORT) and never becomes reachable from the internet.
	@miniapp path /app /app/* /api/miniapp/* /uploads/*
	handle @miniapp {
		reverse_proxy admin:{$ADMIN_PORT:8080}
	}

	handle {
		respond 404
	}
}
