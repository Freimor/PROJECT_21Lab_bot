{
	admin off
	auto_https off
}

{$PUBLIC_DOMAIN} {
	# Certs are issued/renewed offline via DuckDNS DNS-01 (lego). GranLine times
	# out Let's Encrypt validators on inbound 443, so in-process ACME is unreliable.
	tls /certs/{$PUBLIC_DOMAIN}.crt /certs/{$PUBLIC_DOMAIN}.key

	encode zstd gzip

	# Only the Mini App surface is published. The admin UI keeps answering on the
	# LAN port (ADMIN_HOST_PORT) and never becomes reachable from the internet.
	@miniapp path /app /app/* /api/miniapp/* /uploads/*
	handle @miniapp {
		reverse_proxy admin:{$ADMIN_PORT:8080}
	}

	handle {
		respond 404
	}
}
