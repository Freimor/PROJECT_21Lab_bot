# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
BOOTSTRAP_MAGISTER_ID=123456789
# Outbound access to api.telegram.org when direct path is blocked.
# Comma-separated = failover order (try next on transport errors).
# TELEGRAM_PROXY=socks5://amnezia-a:1080
# TELEGRAM_PROXIES=socks5://amnezia-a:1080,socks5://amnezia-b:1080
# Enable Amnezia sidecars: COMPOSE_PROFILES=ollama,amnezia
# Put .conf into secrets/amnezia-a/ and secrets/amnezia-b/ (see docs/NAS_OPS.md)

# ID форум-группы (один для Будней / Важного / Флудилки)
MAIN_CHANNEL_ID=-1001234567890
# ID топиков внутри форума (message_thread_id). Узнать: ссылка на сообщение
# вида https://t.me/c/<chat>/<thread_id>/<message_id>
MAIN_THREAD_ID=2
IMPORTANT_THREAD_ID=3
FLOOD_THREAD_ID=4
JOB_THREAD_ID=5
# Топик витрины магазина — карточки товаров и услуг
SHOP_THREAD_ID=7
# Топик/чат «Баги предложения» — сюда пишут с /bug или /upgrade
BUGS_THREAD_ID=6
# BUGS_CHAT_ID=   # если не задан — MAIN_CHANNEL_ID
# IMPORTANT_CHANNEL_ID / FLOOD_CHAT_ID / JOB_CHAT_ID / SHOP_CHAT_ID можно не задавать — возьмётся MAIN_CHANNEL_ID
# IMPORTANT_CHANNEL_ID=
# FLOOD_CHAT_ID=
# JOB_CHAT_ID=   # отдельный чат заказов (алиас: JOB_CHANNEL_ID)
# SHOP_CHAT_ID=  # отдельный чат витрины

# Отдельный служебный чат staff (не топик форума)
STAFF_CHAT_ID=-1001234567891

# PostgreSQL
POSTGRES_DB=lab21
POSTGRES_USER=lab21
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://lab21:replace-me@postgres:5432/lab21

# Local LLM backends (switch by LLM_PROVIDER):
#   ollama   — CPU via Compose profile `ollama` (default working flow)
#   openvino — in-process OpenVINO GenAI on host NPU/CPU/GPU
#   openai   — any OpenAI-compatible server (vLLM, or scripts/run_openvino_llm_server.py)
#
# --- A) Ollama on CPU (Compose) ---
COMPOSE_PROFILES=ollama
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=qwen3.5:9b
# LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
#
# --- B) OpenVINO NPU in-process (bot must run on Windows/Linux host with NPU) ---
# COMPOSE_PROFILES=
# LLM_PROVIDER=openvino
# LLM_MODEL=C:\path\to\Qwen3.5-9B-int4-ov
# LLM_DEVICE=NPU
# LLM_MAX_NEW_TOKENS=1024
# LLM_TIMEOUT_SECONDS=1800
#
# --- C) Bot in Docker + NPU server on Windows host ---
# COMPOSE_PROFILES=
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://host.docker.internal:8091
# LLM_MODEL=qwen3.5-9b-npu
# LLM_TIMEOUT_SECONDS=1800
# LLM_MAX_NEW_TOKENS=1024
# (host) python scripts/download_openvino_llm.py
# (host) python scripts/run_openvino_llm_server.py --model models/Qwen3.5-9B-int4-ov --preload
#
# Optional mount for Linux+NPU openvino-in-container:
# OPENVINO_MODEL_DIR=./models
LLM_DEVICE=NPU
LLM_MAX_NEW_TOKENS=1024

# Scheduler and economy
TIMEZONE=Europe/Moscow
CONTENT_SILENCE_DAYS=3
REMINDER_HOUR=14
REMINDER_WINDOW_START=12
REMINDER_WINDOW_END=20
TRANSFER_DAILY_LIMIT=100
APPLICATION_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# Self-update / reboot
CONTROL_DIR=/control
APP_GIT_SHA=unknown
GITHUB_REPO=Freimor/PROJECT_21Lab_bot
GITHUB_BRANCH=main
# GITHUB_TOKEN=ghp_optional_for_private_repo
REPO_URL=https://github.com/Freimor/PROJECT_21Lab_bot.git
COMPOSE_PROJECT_NAME=lab21
WATCHDOG_POLL_SECONDS=5

# Web admin UI
ADMIN_ENABLED=true
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8080
ADMIN_BASE_URL=http://localhost:8080
UPLOAD_DIR=/app/uploads
# ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# ADMIN_PASSWORD=optional-emergency-password
# TELEGRAM_BOT_USERNAME=YourBotUsername

# Telegram Mini App (HTTPS required in production)
MINIAPP_ENABLED=true
MINIAPP_BASE_URL=https://your-domain.example/app
