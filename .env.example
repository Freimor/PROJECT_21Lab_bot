# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-me
BOOTSTRAP_MAGISTER_ID=123456789

# ID форум-группы (один для Будней / Важного / Флудилки)
MAIN_CHANNEL_ID=-1001234567890
# ID топиков внутри форума (message_thread_id). Узнать: ссылка на сообщение
# вида https://t.me/c/<chat>/<thread_id>/<message_id>
MAIN_THREAD_ID=2
IMPORTANT_THREAD_ID=3
FLOOD_THREAD_ID=4
JOB_THREAD_ID=5
# Топик витрины магазина — карточки товаров и услуг
SHOP_THREAD_ID=7
# Топик/чат «Баги предложения» — сюда пишут с /bug или /upgrade
BUGS_THREAD_ID=6
# BUGS_CHAT_ID=   # если не задан — MAIN_CHANNEL_ID
# IMPORTANT_CHANNEL_ID / FLOOD_CHAT_ID / JOB_CHAT_ID / SHOP_CHAT_ID можно не задавать — возьмётся MAIN_CHANNEL_ID
# IMPORTANT_CHANNEL_ID=
# FLOOD_CHAT_ID=
# JOB_CHAT_ID=   # отдельный чат заказов (алиас: JOB_CHANNEL_ID)
# SHOP_CHAT_ID=  # отдельный чат витрины

# Отдельный служебный чат staff (не топик форума)
STAFF_CHAT_ID=-1001234567891

# PostgreSQL
POSTGRES_DB=lab21
POSTGRES_USER=lab21
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://lab21:replace-me@postgres:5432/lab21

# Local LLM: ollama or openai (vLLM-compatible)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=lakomoor/vikhr-llama-3.2-1b-instruct:1b
# LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# Scheduler and economy
TIMEZONE=Europe/Moscow
CONTENT_SILENCE_DAYS=3
REMINDER_HOUR=14
REMINDER_WINDOW_START=12
REMINDER_WINDOW_END=20
TRANSFER_DAILY_LIMIT=100
APPLICATION_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# Self-update / reboot
CONTROL_DIR=/control
APP_GIT_SHA=unknown
GITHUB_REPO=Freimor/PROJECT_21Lab_bot
GITHUB_BRANCH=main
# GITHUB_TOKEN=ghp_optional_for_private_repo
REPO_URL=https://github.com/Freimor/PROJECT_21Lab_bot.git
COMPOSE_PROJECT_NAME=lab21
WATCHDOG_POLL_SECONDS=5

# Web admin UI
ADMIN_ENABLED=true
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8080
ADMIN_BASE_URL=http://localhost:8080
UPLOAD_DIR=/app/uploads
# ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# ADMIN_PASSWORD=optional-emergency-password
# TELEGRAM_BOT_USERNAME=YourBotUsername
